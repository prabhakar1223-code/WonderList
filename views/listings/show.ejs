<% layout("/layouts/boilerplate.ejs") %>

<div class="container listing-show">

    <div class="row">

        <div class="col-lg-8 offset-lg-2">

            <img
                src="<%= home.image.url %>"
                class="show-img"
                alt="listing image"
            >
            <div class="owner">
                <i class="fa-solid fa-user"></i>
                <span>Owner: <%= home.owner.username %></span>
             
            </div>

            <div class="show-card">

                <h1 class="show-title">
                    <%= home.title %>
                </h1>

                <p class="show-location">
                    <i class="fa-solid fa-location-dot"></i>
                    <%= home.location %>, <%= home.country %>
                </p>

                <hr>

                <p class="show-description">
                    <%= home.description %>
                </p>

                <div class="show-price">
                    ₹ <%= home.price ? home.price.toLocaleString("en-IN") : "N/A" %>
                    <span>/ night</span>
                </div>
                    
                <div class="show-actions">
                       
                        

                    <a
                        href="/listings/<%= home._id %>/edit"
                        class="btn btn-dark"
                    >
                        <i class="fa-solid fa-pen-to-square"></i>
                        Edit Listing
                    </a>

                    <form
                        action="/listings/<%= home._id %>?_method=DELETE"
                        method="POST"
                    >
                        <button class="btn btn-outline-danger">
                            <i class="fa-solid fa-trash"></i>
                            Delete Listing
                        </button>
                    </form>

                </div>
              
                <hr>
                <div class="review_box">
                    <% if(currentUser){ %>
                    <h4>Leave a Review</h4>
                        
  
                    <form action="/listings/<%=home._id%>/reviews" method="POST" class="needs-validation">
                        <div>
                            <label for="rating">Rating</label>

                            

                            <fieldset class="starability-slot">
  
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>
                        </div>

                        <div>
                            <label for="comment">Comments</label>
                            <textarea name="review[comment]" id="comment"
                            required placeholder="Share you experience with this listing "></textarea>
                        </div>

                        <button>Submit</button>
                    </form>

                 <hr>
                    <%}%>

<h4>All Reviews</h4>

<div class="reviews-container">
    <% for (let r of home.reviews) { %>

        <div class="review-card">
            <div class="review-header">
                <span class="review-user">
                    <i class="fa-solid fa-circle-user"></i>
                    Guest
                </span>

                <span class="review-rating">
                    ★ <%= r.rating %>
                </span>
                  
            </div>

            <p class="review-comment">
               <b>
                <%= r.comment %>
               </b>
            </p>

          
           <form action="/listings/<%=home._id%>/<%=r._id%>/reviews?_method=DELETE" method="POST">
           
            <button>remove</button>
           </form>
        </div>

    <% } %>
</div>
                
                </div>

            </div>

        </div>

    </div>

</div>

