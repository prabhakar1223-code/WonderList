      <!-- DESIGN -->

      <div
        class="filter"
        data-filter="design"
        onclick="selectCategory(this)"
      >

        <i class="fa-solid fa-palette"></i>

        <p>Design</p>

      </div>


      <!-- SNOW -->

      <div
        class="filter"
        data-filter="snow"
        onclick="selectCategory(this)"
      >

        <i class="fa-solid fa-snowflake"></i>

        <p>Snow</p>

      </div>


      <!-- VINEYARDS -->

      <div
        class="filter"
        data-filter="vineyards"
        onclick="selectCategory(this)"
      >

        <i class="fa-solid fa-wine-glass"></i>

        <p>Vineyards</p>

      </div>


    </div>


    <!-- RIGHT ARROW -->

    <button
      type="button"
      class="filter-arrow filter-arrow-right"
      id="filterRight"
      aria-label="Scroll filters right"
    >

      <i class="fa-solid fa-chevron-right"></i>

    </button>

  </div>

</div>


<!-- =====================================================
     LISTINGS
===================================================== -->

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4">


  <% for(let list of allList) { %>


    <div class="col">

      <div class="card listing-card h-100">


        <!-- IMAGE -->

        <img
          src="<%= list.image.url %>"
          class="card-img-top listing-img"
          alt="listing_image"
        >


        <!-- CARD BODY -->

        <div class="card-body d-flex flex-column">


          <!-- TITLE -->

          <h5 class="card-title">

            <%= list.title %>

          </h5>


          <!-- DESCRIPTION -->

          <p class="card-text text-muted">

            <%= list.description %>

          </p>


          <!-- LOCATION -->

          <p class="listing-location">

            <%= list.location %>,
            <%= list.country %>

          </p>


          <!-- PRICE -->

          <p class="listing-price mt-auto">

            <b>

              Rs.

              <%= list.price
                ? list.price.toLocaleString("en-IN")
                : "N/A"
              %>

              <span class="tax_info">
                +18% GST
              </span>

            </b>

            / night

          </p>


          <!-- VIEW LISTING -->

          <a
            href="/listings/<%= list._id %>"
            class="btn btn-primary"
          >

            View Listing

          </a>


        </div>

      </div>

    </div>


  <% } %>


</div>


<!-- =====================================================
     JAVASCRIPT
===================================================== -->

<script>


  /* =====================================================
     CATEGORY SELECTION
  ===================================================== */

  function selectCategory(element) {

    document
      .querySelectorAll(".filter")
      .forEach(filter => {

        filter.classList.remove("active");

      });


    element.classList.add("active");


    const category =
      element.dataset.filter;


    console.log(
      "Selected category:",
      category
    );


    /*
     * BACKEND LOGIC WILL GO HERE
     *
     * Later:
     *
     * window.location.href =
     * `/listings?category=${category}`;
     */

  }


  /* =====================================================
     FILTER HORIZONTAL SCROLL
  ===================================================== */

  const filters =
    document.getElementById("filters");

  const leftButton =
    document.getElementById("filterLeft");

  const rightButton =
    document.getElementById("filterRight");


  const scrollAmount = 350;


  /* LEFT */

  leftButton.addEventListener(
    "click",
    function() {

      filters.scrollBy({

        left: -scrollAmount,

        behavior: "smooth"

      });

    }
  );


  /* RIGHT */

  rightButton.addEventListener(
    "click",
    function() {

      filters.scrollBy({

        left: scrollAmount,

        behavior: "smooth"

      });

    }
  );


  /* =====================================================
     TAX TOGGLE
  ===================================================== */

  const taxToggle =
    document.getElementById("taxToggle");


  taxToggle.addEventListener(
    "change",
    function() {

      const taxInfo =
        document.querySelectorAll(".tax_info");


      taxInfo.forEach(function(info) {

        if (taxToggle.checked) {

          /*
           * SHOW GST
           */

          info.style.display = "inline";

        } else {

          /*
           * HIDE GST
           */

          info.style.display = "none";

        }

      });


      console.log(
        "Tax display:",
        taxToggle.checked
      );

    }
  );


</script>