<!-- =====================================================
     FILTERS
===================================================== -->

<div class="filters-wrapper">

  <div class="filters-container">


    <!-- LEFT ARROW -->

    <button
      type="button"
      class="filter-arrow filter-arrow-left"
      id="filterLeft"
      aria-label="Scroll filters left"
    >

      <i class="fa-solid fa-chevron-left"></i>

    </button>


    <!-- FILTER LIST -->

    <div
      class="filters"
      id="filters"
    >


      <!-- TRENDING -->

      <div
        class="filter active"
        data-filter="trending"
        onclick="selectCategory(this)"
      >

        <i class="fa-solid fa-fire"></i>

        <p>Trending</p>

      </div>


      <!-- AMAZING VIEWS -->

      <div
        class="filter"
        data-filter="amazing-views"
        onclick="selectCategory(this)"
      >

        <i class="fa-solid fa-mountain-sun"></i>

        <p>Amazing views</p>

      </div>


      <!-- BEACH -->

      <div
        class="filter"
        data-filter="beach"
        onclick="selectCategory(this)"
      >

        <i class="fa-solid fa-umbrella-beach"></i>

        <p>Beach</p>

      </div>


      <!-- MOUNTAINS -->

      <div
        class="filter"
        data-filter="mountains"
        onclick="selectCategory(this)"
      >

        <i class="fa-solid fa-mountain"></i>

        <p>Mountains</p>

      </div>


      <!-- POOLS -->

      <div
        class="filter"
        data-filter="pools"
        onclick="selectCategory(this)"
      >

        <i class="fa-solid fa-person-swimming"></i>

        <p>Pools</p>

      </div>


      <!-- CABINS -->

      <div
        class="filter"
        data-filter="cabins"
        onclick="selectCategory(this)"
      >

        <i class="fa-solid fa-house"></i>

        <p>Cabins</p>

      </div>


      <!-- ROOMS -->

      <div
        class="filter"
        data-filter="rooms"
        onclick="selectCategory(this)"
      >

        <i class="fa-solid fa-bed"></i>

        <p>Rooms</p>

      </div>


      <!-- LUXURY -->

      <div
        class="filter"
        data-filter="luxury"
        onclick="selectCategory(this)"
      >

        <i class="fa-solid fa-gem"></i>

        <p>Luxury</p>

      </div>


      <!-- TOP RATED -->

      <div
        class="filter"
        data-filter="top-rated"
        onclick="selectCategory(this)"
      >

        <i class="fa-solid fa-star"></i>

        <p>Top rated</p>

      </div>


      <!-- FARMS -->

      <div
        class="filter"
        data-filter="farms"
        onclick="selectCategory(this)"
      >

        <i class="fa-solid fa-wheat-awn"></i>

        <p>Farms</p>

      </div>


      <!-- COUNTRYSIDE -->

      <div
        class="filter"
        data-filter="countryside"
        onclick="selectCategory(this)"
      >

        <i class="fa-solid fa-tree"></i>

        <p>Countryside</p>

      </div>


      <!-- LAKE -->

      <div
        class="filter"
        data-filter="lake"
        onclick="selectCategory(this)"
      >

        <i class="fa-solid fa-water"></i>

        <p>Lake</p>

      </div>


      <!-- ISLANDS -->

      <div
        class="filter"
        data-filter="islands"
        onclick="selectCategory(this)"
      >

        <i class="fa-solid fa-umbrella-beach"></i>

        <p>Islands</p>

      </div>


      <!-- CAMPING -->

      <div
        class="filter"
        data-filter="camping"
        onclick="selectCategory(this)"
      >

        <i class="fa-solid fa-campground"></i>

        <p>Camping</p>

